FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY server/ ./server/
COPY favicon.ico .

EXPOSE 8791

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=15s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8791/health', timeout=3)"

CMD ["gunicorn", "--bind", "0.0.0.0:8791", "--workers", "2", "--timeout", "150", "server.app:app"]
